# ============================================================
# .env.example — copie para .env e preencha com seus valores.
# O arquivo .env real está no .gitignore e NUNCA deve ser commitado.
#
# Como usar:
#   1. cp .env.example .env       (Linux/macOS)
#      copy .env.example .env     (Windows)
#   2. Edite .env e cole suas chaves.
#   3. Rode normalmente: mvn spring-boot:run
# ============================================================

# --- Google OAuth2 (opcional) ---
# Gere em https://console.cloud.google.com/ → Credenciais → ID do cliente OAuth.
# Para ATIVAR o login Google, descomente também a linha do profile abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Profile que liga o registration OAuth2.
# Use a forma canônica (minúsculas com pontos) — é assim que o Spring lê
# de arquivos .properties. A variante SPRING_PROFILES_ACTIVE só vale como
# variável de ambiente real do shell.
spring.profiles.active=oauth

# --- PostgreSQL (opcional) ---
# Se quiser usar Postgres em vez do H2 embutido, descomente e preencha:
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/softgroup
#SPRING_DATASOURCE_USERNAME=postgres
#SPRING_DATASOURCE_PASSWORD=
#SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
#SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
#H2_CONSOLE=false
